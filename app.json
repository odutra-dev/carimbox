{
  "expo": {
    "name": "carimbox",
    "slug": "carimbox",
    "version": "1.0.0",
    "scheme": "acme",
    "description": "App para controle dos pedidos de carimbos",
    "userInterfaceStyle": "automatic",

    "plugins": ["expo-router", "expo-font"],
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/logo.png"
    },
    "android": {
      "package": "com.dutradev.carimbox",
      "icon": "./assets/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f7f26da3-45c6-4ca0-b4e8-1b24979d7312"
      }
    }
  }
}
